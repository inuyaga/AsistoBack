# Trusted Hosts & CORS Origins
ALLOWED_HOSTS=["attendance.local","*.attendance.local","localhost","127.0.0.1"]
CORS_ORIGINS=["http://attendance.local:5173","http://attendance.local","https://attendance.local","http://localhost:5173","http://127.0.0.1:5173"]
