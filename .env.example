PROJECT_NAME=Attendance System API
VERSION=0.1.0
API_V1_STR=/api/v1

# Server Host & Port
APP_HOST=attendance.local
APP_PORT=8000

# JWT Security Configuration
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=attendance_db

# Or override directly with DATABASE_URL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/attendance_db

# Trusted Hosts & CORS Origins
ALLOWED_HOSTS=["attendance.local","*.attendance.local","localhost","127.0.0.1"]
CORS_ORIGINS=["http://attendance.local:5173","http://attendance.local","https://attendance.local","http://localhost:5173","http://127.0.0.1:5173"]

# Media Storage ('local' or 's3')
MEDIA_STORAGE_BACKEND=local
MEDIA_ROOT_DIR=media
# S3_BUCKET_NAME=asisto-media
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Hikvision ISUP 5.0 Sidecar (.NET 8)
# En Docker Compose usar el DNS interno: http://asisto-isup:8080
ISUP_SIDECAR_URL=http://asisto-isup:8080
ISUP_INTERNAL_API_KEY=CHANGE_ME_INTERNAL_SECRET_KEY
ISUP_INTERNAL_API_HEADER=X-Internal-Api-Key
ISUP_REQUEST_TIMEOUT_SECONDS=15.0
ISUP_ENCRYPTION_KEY=CHANGE_ME_ISUP5_KEY
ISUP_SERVER_HOST=attendance.local
ISUP_SERVER_PORT=7660
# Opcional: URL pública alcanzable por los biométricos ISUP para descargar faceURL.
# En producción detrás de reverse proxy HTTPS sin puerto: https://api.tudominio.com (o https://api.tudominio.com/api/v1)
# Si se omite, usa MEDIA_PUBLIC_BASE_URL o http://<ISUP_SERVER_HOST>:<APP_PORT>/api/v1
# ISUP_FACE_PUBLIC_BASE_URL=https://api.tudominio.com
# ISUP_FACE_URL_TTL_SECONDS=120
